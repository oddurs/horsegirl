{
  "name": "horsegirl-site",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": "24.22.3"
  },
  "scripts": {
    "dev": "next dev --port 3044",
    "build": "next build && node scripts/check-export.mjs && node scripts/check-a11y.mjs && node scripts/check-lighthouse.mjs",
    "fmt": "biome format --write",
    "fmt:check": "biome format",
    "lint": "biome lint --error-on-warnings",
    "test": "node --test tests/*.test.ts",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "marked": "18.3.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.14.1",
    "lighthouse": "13.6.0",
    "typescript": "7.0.2"
  }
}
