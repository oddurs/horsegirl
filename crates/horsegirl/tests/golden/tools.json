          "type": "integer"
        },
        "notes": {
          "minimum": 0,
          "type": "integer"
        },
        "svg": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "The picture as SVG, or `null` when the file has an error."
        },
        "warnings": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
