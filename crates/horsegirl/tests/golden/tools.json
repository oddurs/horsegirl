      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "diagnostics": {
          "description": "Every diagnostic of the file.",
          "items": {
            "$ref": "#/$defs/Diagnostic"
          },
          "type": "array"
        },
        "errors": {
