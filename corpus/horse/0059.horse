# Converted from corpus/flowcharts/0059.mmd by corpus/convert.py.
"Browser: public/ app" -> server.mjs: session cookie
server.mjs -> generation.mjs + providers.mjs
server.mjs -> publishing.mjs
server.mjs -> media.mjs
server.mjs -> "configuration.mjs: local settings"
