#!/bin/sh
# The one interface between automation and the toolchain. CI, the git hooks and
# scripts/agent call these verbs and know nothing else about the stack.
set -eu
cd "$(dirname "$0")/.."

# A tool that CI must have, but a contributor may lack for an optional check.
optional() {
  command -v "$1" >/dev/null 2>&1 && return 0
  if [ -n "${CI:-}" ]; then
    echo "task: $1 is required in CI" >&2
    exit 1
  fi
  echo "task: $1 not found; skipped (CI runs this check)" >&2
  return 1
}

# Runs one script of the site in site/. The Rust checks stand alone, so the site
# verbs run only where site/ exists, and a contributor without pnpm skips them.
site_installed=
site() {
  [ -d site ] || return 0
  optional pnpm || return 0
  if [ -z "$site_installed" ]; then
    pnpm --dir site install --frozen-lockfile
    site_installed=1
  fi
  NEXT_TELEMETRY_DISABLED=1 pnpm --dir site run "$1"
}

# The generator of the text metrics table is its own package, so the shaping
# crate it needs stays out of the workspace. The checks still cover it.
generator=tools/text-metrics/Cargo.toml

fmt() {
  cargo fmt --all
  cargo fmt --manifest-path "$generator"
  site fmt
}

fmt_check() {
  cargo fmt --all -- --check
  cargo fmt --manifest-path "$generator" -- --check
  site fmt:check
}

lint() {
  cargo clippy --workspace --all-targets --locked -- -D warnings
  cargo clippy --manifest-path "$generator" --all-targets --locked -- -D warnings
  scripts/check-core-deps
  if optional shellcheck; then
    shellcheck scripts/task scripts/agent scripts/setup scripts/check-pr-title scripts/check-core-deps scripts/dependabot-update-type scripts/dependabot-automerge .githooks/* tests/agent.sh tests/dependabot.sh tests/automerge.sh tests/pins.sh tests/core-deps.sh tools/text-metrics/generate.sh
  fi
  # The backlog is part of the tree: an invalid item or a stale roadmap is a lint error.
  if [ -f cairn.toml ] && optional cairn; then
    cairn check --render --strict
  fi
  site lint
  site typecheck
}

# The core gives the same bytes natively and in WebAssembly, so its tests run
# in both. Node runs the WebAssembly tests: the site needs it already.
test_wasm() {
  optional node || return 0
  CARGO_TARGET_WASM32_WASIP1_RUNNER="node --disable-warning=ExperimentalWarning $PWD/scripts/wasi-run.mjs" \
    cargo test -p horsegirl-core --target wasm32-wasip1 --locked
}

test_core() {
  cargo test -p horsegirl-core --locked
  test_wasm
}

test_all() {
  if command -v cargo-nextest >/dev/null 2>&1; then
    cargo nextest run --workspace --locked
  else
    cargo test --workspace --locked
  fi
  test_wasm
  site test
  sh tests/agent.sh
  sh tests/dependabot.sh
  sh tests/automerge.sh
  sh tests/pins.sh
  sh tests/core-deps.sh
}

build() {
  cargo build --workspace --locked
  # Builds site/out and serves it under the base path to prove every link resolves.
  site build
}

case "${1:-}" in
  fmt) fmt ;;
  fmt:check) fmt_check ;;
  lint) lint ;;
  test) test_all ;;
  test:core) test_core ;;
  build) build ;;
  check)
    fmt_check
    lint
    test_all
    build
    ;;
  *)
    echo "usage: scripts/task {fmt|fmt:check|lint|test|test:core|build|check}" >&2
    exit 2
    ;;
esac
