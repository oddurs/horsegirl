#!/bin/sh
# One unit of work, one worktree, one branch, one pull request.
set -eu

say() { printf 'agent: %s\n' "$*"; }
die() {
  printf 'agent: %s\n' "$*" >&2
  exit 1
}

git rev-parse --show-toplevel >/dev/null 2>&1 || die "not inside a git repository"
here=$(git rev-parse --show-toplevel)
common=$(cd "$here" && cd "$(git rev-parse --git-common-dir)" && pwd)
root=$(dirname "$common") # the primary checkout
name=$(basename "$root")
branch_re='^(feat|fix|chore|docs|perf|refactor|test)/[a-z0-9][a-z0-9._-]*$'
commit_re=$(cat "$here/scripts/commit-pattern")

default_branch() {
  ref=$(git -C "$root" symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null) && {
    echo "${ref#origin/}"
    return
  }
  git -C "$root" config init.defaultBranch 2>/dev/null || echo main
}

current_branch() { git -C "$here" rev-parse --abbrev-ref HEAD; }

worktree_of() { echo "$(dirname "$root")/.worktrees/$name/$1"; }

guard_attribution() {
  if grep -Eiqf "$root/scripts/attribution-patterns" "$1"; then
    die "the text names an assistant or a model; the work is published under the owner's name. Remove that line."
  fi
}

# Untracked local files live only in the primary checkout. Link each literal
# path named in info/exclude into a new worktree. A pattern names no file that
# exists, so only literal paths are linked.
link_local() {
  exclude=$common/info/exclude
  [ -f "$exclude" ] || return 0
  grep -v '^[[:space:]]*#' "$exclude" | while IFS= read -r entry; do
    path=${entry#/}
    path=${path%/}
    [ -n "$path" ] || continue
    if [ ! -e "$root/$path" ] || [ -e "$1/$path" ] || [ -L "$1/$path" ]; then
      continue
    fi
    mkdir -p "$(dirname "$1/$path")"
    ln -s "$root/$path" "$1/$path"
    say "linked $path from the primary checkout"
  done
}

cmd_doctor() {
  bad=0
  problem() {
    printf 'agent: problem: %s\n' "$*" >&2
    bad=1
  }
  for tool in git gh cargo; do
    command -v "$tool" >/dev/null 2>&1 || problem "$tool is not installed"
  done
  if command -v gh >/dev/null 2>&1; then
    gh auth status >/dev/null 2>&1 || problem "gh is not signed in; run: gh auth login"
  fi
  if [ "$(git -C "$root" config core.hooksPath 2>/dev/null)" != ".githooks" ]; then
    say "setting core.hooksPath to .githooks"
    git -C "$root" config core.hooksPath .githooks
  fi
  for hook in commit-msg pre-commit pre-push; do
    [ -x "$root/.githooks/$hook" ] || problem ".githooks/$hook is missing or not executable"
  done
  cargo --version >/dev/null 2>&1 || problem "the Rust toolchain in rust-toolchain.toml is not installed"
  command -v cairn >/dev/null 2>&1 || say "note: cairn is not installed; the backlog check runs only in CI"
  [ -z "$(git -C "$here" status --porcelain)" ] || problem "the working tree in $here has uncommitted changes"
  [ "$bad" -eq 0 ] || exit 1
  say "ok"
}

cmd_start() {
  branch=${1:-}
  [ -n "$branch" ] || die "usage: scripts/agent start <type>/<slug>"
  echo "$branch" | grep -Eq "$branch_re" ||
    die "branch '$branch' must match $branch_re, for example feat/0012-parse-links"
  def=$(default_branch)
  wt=$(worktree_of "$branch")
  say "fetching origin"
  git -C "$root" fetch --quiet origin
  if git -C "$root" show-ref --verify --quiet "refs/heads/$branch"; then
    die "branch '$branch' already exists; choose another name or run: scripts/agent done $branch"
  fi
  [ ! -e "$wt" ] || die "worktree path $wt already exists"
  say "creating $branch from origin/$def in $wt"
  mkdir -p "$(dirname "$wt")"
  git -C "$root" worktree add --quiet -b "$branch" "$wt" "origin/$def"
  link_local "$wt"
  # A slug that starts with an item number takes that item in the backlog.
  item=$(echo "${branch#*/}" | sed -n 's/^\([0-9][0-9]*\)-.*/\1/p')
  if [ -n "$item" ] && [ -f "$wt/cairn.toml" ] && command -v cairn >/dev/null 2>&1; then
    say "claiming item $item"
    if ! cairn -C "$wt" claim "$item"; then
      git -C "$root" worktree remove --force "$wt"
      git -C "$root" branch --quiet -D "$branch"
      die "item $item was not claimed, so the worktree was removed. Read the message above."
    fi
  fi
  say "ready. Move there with: cd $wt"
}

cmd_check() { "$here/scripts/task" check; }

cmd_commit() {
  msg=${1:-}
  [ -n "$msg" ] || die "usage: scripts/agent commit '<type>(<scope>): <subject>'"
  subject=$(printf '%s\n' "$msg" | head -n 1)
  echo "$subject" | grep -Eq "$commit_re" ||
    die "'$subject' is not a Conventional Commit, for example: feat(parser): read fan-out links"
  [ "${#subject}" -le 72 ] || die "the subject has ${#subject} characters; the limit is 72"
  git -C "$here" commit -m "$msg"
}

cmd_pr() {
  draft=
  auto=
  body=
  while [ $# -gt 0 ]; do
    case "$1" in
      --draft) draft=--draft ;;
      --auto) auto=1 ;;
      --body-file)
        shift
        body=${1:-}
        ;;
      *) die "usage: scripts/agent pr [--draft] [--auto] [--body-file <file>]" ;;
    esac
    shift
  done
  def=$(default_branch)
  branch=$(current_branch)
  [ "$branch" != "$def" ] || die "you are on $def; start a branch with: scripts/agent start <type>/<slug>"
  [ -n "${checked:-}" ] || cmd_check
  say "pushing $branch"
  git -C "$here" push --quiet -u origin "$branch"
  if url=$(cd "$here" && gh pr view --json url -q .url 2>/dev/null); then
    say "the pull request already exists"
  else
    title=$(git -C "$here" log --reverse --format=%s "origin/$def..HEAD" | head -n 1)
    tmp=$(mktemp)
    if [ -n "$body" ]; then
      cat "$body" >"$tmp"
    else
      git -C "$here" log --reverse --format='%b' "origin/$def..HEAD" >"$tmp"
    fi
    guard_attribution "$tmp"
    # shellcheck disable=SC2086 # $draft is one flag or nothing
    url=$(cd "$here" && gh pr create --title "$title" --body-file "$tmp" $draft)
    rm -f "$tmp"
  fi
  if [ -n "$auto" ]; then
    say "the pull request merges itself when the required check passes"
    (cd "$here" && gh pr merge --auto --squash)
  fi
  say "$url"
}

# Rebase onto the default branch. The roadmap is generated, so a conflict in it
# alone is resolved by generating it again. Any other conflict needs a person.
rebase_onto_default() {
  def=$(default_branch)
  git -C "$here" fetch --quiet origin
  if git -C "$here" merge-base --is-ancestor "origin/$def" HEAD; then
    return 0
  fi
  say "rebasing $(current_branch) onto origin/$def"
  if ! out=$(git -C "$here" rebase "origin/$def" 2>&1); then
    while [ -d "$(git -C "$here" rev-parse --git-path rebase-merge)" ]; do
      conflicts=$(git -C "$here" diff --name-only --diff-filter=U)
      if [ "$conflicts" != "ROADMAP.md" ]; then
        die "the rebase stopped on a conflict in: $(echo "$conflicts" | tr '\n' ' '). Resolve it in $here, run 'git rebase --continue', then run this command again."
      fi
      say "generating ROADMAP.md again"
      cairn -C "$here" render -q --no-hooks ||
        die "cairn render failed during the rebase. Fix the backlog in $here, run 'git add ROADMAP.md && git rebase --continue', then run this command again."
      git -C "$here" add ROADMAP.md
      GIT_EDITOR=true git -C "$here" rebase --continue >/dev/null 2>&1 || true
    done
  fi
  # Whatever happened above, the only acceptable result is a finished rebase.
  git -C "$here" merge-base --is-ancestor "origin/$def" HEAD ||
    die "the rebase onto origin/$def did not complete: ${out:-no output}"
  # A roadmap generated mid-rebase can be stale once every commit is replayed.
  if [ -f "$here/cairn.toml" ] && command -v cairn >/dev/null 2>&1; then
    cairn -C "$here" render -q --no-hooks
    if ! git -C "$here" diff --quiet -- ROADMAP.md; then
      git -C "$here" commit --quiet -m "docs(backlog): regenerate the roadmap" -- ROADMAP.md
    fi
  fi
}

cmd_sync() {
  [ -z "$(git -C "$here" status --porcelain)" ] || die "the working tree has uncommitted changes; commit them first"
  rebase_onto_default
  say "up to date with origin/$(default_branch). Push with: scripts/agent land"
}

pr_state() {
  (cd "$here" && gh pr view --json state,mergeStateStatus -q '.state + " " + .mergeStateStatus' 2>/dev/null) || echo "UNKNOWN UNKNOWN"
}

# Bring the branch up to date, push it, and wait until its pull request merges.
# The default branch can move while CI runs, so this repeats until it lands.
cmd_land() {
  def=$(default_branch)
  branch=$(current_branch)
  [ "$branch" != "$def" ] || die "you are on $def; run this from the branch's worktree"
  [ -z "$(git -C "$here" status --porcelain)" ] || die "the working tree has uncommitted changes"
  attempt=0
  while :; do
    case "$(pr_state)" in
      MERGED*)
        say "merged"
        return 0
        ;;
      CLOSED*) die "the pull request for $branch is closed" ;;
    esac
    attempt=$((attempt + 1))
    [ "$attempt" -le 20 ] || die "the pull request did not land after 20 attempts; read 'gh pr view $branch'"
    git -C "$here" fetch --quiet origin
    # A force-push must never remove a commit this worktree has not seen.
    if git -C "$here" rev-parse --verify --quiet "origin/$branch" >/dev/null &&
      ! git -C "$here" merge-base --is-ancestor "origin/$branch" HEAD; then
      die "origin/$branch has commits that this worktree lacks. Bring them in with 'git pull --rebase origin $branch', then run this command again."
    fi
    rebase_onto_default
    if [ "$(git -C "$here" rev-parse HEAD)" != "$(git -C "$here" rev-parse --verify --quiet "origin/$branch")" ]; then
      say "pushing $branch"
      git -C "$here" push --quiet --force-with-lease origin "$branch"
    fi
    (cd "$here" && gh pr merge --auto --squash >/dev/null 2>&1) || true
    # Poll, so that a moved default branch is noticed at once and not after CI.
    waited=0
    while [ "$waited" -lt 2700 ]; do
      sleep 10
      waited=$((waited + 10))
      case "$(pr_state)" in
        MERGED*)
          say "merged"
          return 0
          ;;
        CLOSED*) die "the pull request for $branch is closed" ;;
        "OPEN CLEAN")
          # Auto-merge cannot be set on a pull request that is already
          # mergeable, so nothing would ever merge it. Merge it now.
          (cd "$here" && gh pr merge --squash >/dev/null 2>&1) || true
          ;;
        "OPEN BEHIND" | "OPEN DIRTY")
          say "the default branch moved; bringing $branch up to date again"
          continue 2
          ;;
      esac
      buckets=$(cd "$here" && gh pr checks --required --json bucket -q '.[].bucket' 2>/dev/null) || buckets=
      case "$buckets" in
        *fail* | *cancel*) die "a required check failed on $branch; read 'gh pr checks' in $here" ;;
      esac
    done
    die "the pull request for $branch did not merge within 45 minutes"
  done
}

item_number() { echo "${1#*/}" | sed -n 's/^0*\([0-9][0-9]*\)-.*/\1/p'; }

item_field() { cairn -C "$2" show "$1" --raw | sed -n "s/^$3: *//p" | head -n 1 | sed "s/^[\"']//; s/[\"']\$//"; }

# Take an item: name the branch from it, start the worktree, claim it, and
# print it as the prompt to work from.
cmd_take() {
  command -v cairn >/dev/null 2>&1 || die "cairn is not installed; see CONTRIBUTING.md"
  id=${1:-}
  # Choose from the backlog as it is on the default branch, not as it was.
  git -C "$root" fetch --quiet origin
  if [ "$(git -C "$root" rev-parse --abbrev-ref HEAD)" = "$(default_branch)" ] &&
    [ -z "$(git -C "$root" status --porcelain)" ]; then
    git -C "$root" merge --quiet --ff-only "origin/$(default_branch)"
  fi
  if [ -z "$id" ]; then
    id=$(cairn -C "$root" next --view agent --ids --limit 1)
    [ -n "$id" ] || die "nothing is ready in the agent view; see 'cairn next --blocked'"
  fi
  type=$(item_field "$id" "$root" type)
  title=$(item_field "$id" "$root" title)
  number=$(item_field "$id" "$root" id)
  [ -n "$number" ] && [ -n "$title" ] || die "no item '$id' in the backlog"
  case "$type" in
    feature | lens) kind=feat ;;
    bug) kind=fix ;;
    docs | decision) kind=docs ;;
    *) kind=chore ;;
  esac
  slug=$(printf '%s' "$title" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9][^a-z0-9]*/-/g; s/^-//; s/-$//' | cut -c1-40 | sed 's/-$//')
  [ -n "$slug" ] || slug=item
  branch=$(printf '%s/%04d-%s' "$kind" "$number" "$slug")
  cmd_start "$branch" >&2
  cairn -C "$(worktree_of "$branch")" prompt "$number"
}

# Finish the item this branch carries: check, close it, commit the backlog,
# and open the pull request with a body built from the item.
cmd_finish() {
  auto=--auto
  body=
  while [ $# -gt 0 ]; do
    case "$1" in
      --no-auto) auto= ;;
      --body-file)
        shift
        body=${1:-}
        ;;
      *) die "usage: scripts/agent finish [--no-auto] [--body-file <file>]" ;;
    esac
    shift
  done
  command -v cairn >/dev/null 2>&1 || die "cairn is not installed; see CONTRIBUTING.md"
  branch=$(current_branch)
  number=$(item_number "$branch")
  [ -n "$number" ] || die "branch '$branch' does not start with an item number; use: scripts/agent pr"
  unticked=$(cairn -C "$here" show "$number" --criteria | grep -E '^ *[0-9]+ +\[ \]' || true)
  if [ -n "$unticked" ]; then
    printf 'agent: these criteria are not ticked. Tick each one that is true with: cairn tick %s <n>\n%s\n' "$number" "$unticked" >&2
    exit 1
  fi
  [ -z "$(git -C "$here" status --porcelain -- . ':!cairn' ':!ROADMAP.md')" ] ||
    die "there are uncommitted changes outside the backlog; commit them first"
  # Check before the item is closed, so a failure leaves no close commit behind.
  cmd_check
  checked=1
  if [ "$(item_field "$number" "$here" status)" != "done" ]; then
    say "closing item $number"
    cairn -C "$here" close "$number" -q
  fi
  ref=$(printf '%04d' "$number")
  if [ -n "$(git -C "$here" status --porcelain)" ]; then
    git -C "$here" add -A cairn ROADMAP.md
    git -C "$here" commit --quiet -m "docs(backlog): close $ref"
  fi
  item_body=
  if [ -z "$body" ]; then
    item_body=$(mktemp)
    # Everything the item says above its criteria, then the reference.
    cairn -C "$here" show "$number" --raw | awk '
      body && tolower($0) ~ /^## acceptance criteria/ { exit }
      body { print }
      /^(---|\.\.\.)[[:space:]]*$/ { seen++; if (seen == 2) body = 1 }
    ' >"$item_body"
    printf 'Refs: %s\n' "$ref" >>"$item_body"
    body=$item_body
  fi
  # shellcheck disable=SC2086 # $auto is one flag or nothing
  cmd_pr $auto --body-file "$body"
  [ -z "$item_body" ] || rm -f "$item_body"
}

# The version every crate of the workspace inherits.
workspace_version() { sed -n '/^\[workspace.package\]/,/^\[/s/^version = "\(.*\)"$/\1/p' "$1"; }

# The non-blank lines of the Unreleased section of a changelog.
unreleased() { awk '/^## \[Unreleased\]/ { on = 1; next } on && /^## / { exit } on && NF { print }' "$1"; }

# Prints 1 when version $1 is newer than version $2 by Semantic Versioning.
version_newer() {
  awk -v a="$1" -v b="$2" '
    function isnum(s) { return s ~ /^[0-9]+$/ }
    # Compares two identifiers: numbers by value, a number below a word.
    function cmp(x, y) {
      if (isnum(x) && isnum(y)) return (x + 0 > y + 0) - (x + 0 < y + 0)
      if (isnum(x)) return -1
      if (isnum(y)) return 1
      return (x > y) - (x < y)
    }
    BEGIN {
      i = index(a, "-"); ca = i ? substr(a, 1, i - 1) : a; pa = i ? substr(a, i + 1) : ""
      i = index(b, "-"); cb = i ? substr(b, 1, i - 1) : b; pb = i ? substr(b, i + 1) : ""
      split(ca, x, "."); split(cb, y, ".")
      for (i = 1; i <= 3; i++) if ((c = cmp(x[i], y[i])) != 0) { print (c > 0); exit }
      # A pre-release is older than the release of the same number.
      if (pa == pb) { print 0; exit }
      if (pa == "") { print 1; exit }
      if (pb == "") { print 0; exit }
      n = split(pa, p, "."); m = split(pb, q, ".")
      for (i = 1; i <= n && i <= m; i++) if ((c = cmp(p[i], q[i])) != 0) { print (c > 0); exit }
      print (n > m)
    }'
}

# Prepare a release on its own branch and open its pull request. The release
# workflow tags the merge commit, and the tag publishes the release.
cmd_release() {
  version=${1:-}
  version=${version#v}
  [ -n "$version" ] || die "usage: scripts/agent release <version>, for example: scripts/agent release 0.1.0"
  echo "$version" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z-]+(\.[0-9A-Za-z-]+)*)?$' ||
    die "'$version' is not a version. Write MAJOR.MINOR.PATCH, for example 0.1.0, or 0.1.0-rc.1 for a pre-release"
  def=$(default_branch)
  [ "$(current_branch)" = "$def" ] ||
    die "a release starts on $def, and this checkout is on $(current_branch). Run the command in $root on $def"
  [ -z "$(git -C "$here" status --porcelain)" ] ||
    die "the working tree has uncommitted changes. A release starts from a clean $def"
  git -C "$here" fetch --quiet origin
  [ "$(git -C "$here" rev-parse HEAD)" = "$(git -C "$here" rev-parse "origin/$def")" ] ||
    die "$def is not the same as origin/$def. Run 'git -C $here pull --ff-only', then run this command again"
  current=$(workspace_version "$here/Cargo.toml")
  [ -n "$current" ] || die "Cargo.toml states no version under [workspace.package]"
  [ "$(version_newer "$version" "$current")" = 1 ] ||
    die "$version is not newer than the current version $current. Choose a higher version"
  notes=$(unreleased "$here/CHANGELOG.md")
  [ -n "$notes" ] || die "the Unreleased section of CHANGELOG.md is empty. A release needs at least one entry"
  [ -z "$(git -C "$here" ls-remote --tags origin "refs/tags/v$version")" ] ||
    die "the tag v$version already exists on origin. Choose another version"

  branch=chore/release-$version
  cmd_start "$branch"
  here=$(worktree_of "$branch")
  # Only the changelog needs the date; the program output never reads it.
  date=${RELEASE_DATE:-$(date -u +%Y-%m-%d)}
  log=$here/CHANGELOG.md
  awk -v v="$version" -v d="$date" '
    { print }
    /^## \[Unreleased\]/ && !done { print ""; print "## [" v "] - " d; done = 1 }
  ' "$log" >"$log.new"
  mv "$log.new" "$log"
  sed -i.bak '/^\[workspace.package\]/,/^\[/s/^version = ".*"$/version = "'"$version"'"/' "$here/Cargo.toml"
  rm -f "$here/Cargo.toml.bak"
  if [ -f "$here/docs/quickstart.md" ]; then
    sed -i.bak "s/^horsegirl $current\$/horsegirl $version/" "$here/docs/quickstart.md"
    rm -f "$here/docs/quickstart.md.bak"
  fi
  # Resolving the workspace writes the new versions into Cargo.lock.
  (cd "$here" && cargo metadata --format-version 1 --offline >/dev/null)
  crates=$(cd "$here" && cargo metadata --no-deps --format-version 1 --offline --locked)
  if stale=$(echo "$crates" | grep -o '"name":"[^"]*","version":"[^"]*"' | grep -v "\"version\":\"$version\""); then
    die "these crates do not take the workspace version. Set 'version.workspace = true' in each: $stale"
  fi

  git -C "$here" commit --quiet -a -m "chore(release): v$version" -m "Moves the Unreleased section of CHANGELOG.md under $version and sets every crate of the workspace to $version. When this pull request merges, the release workflow tags the merge commit v$version and publishes the release."
  body=$(mktemp)
  {
    printf 'Releases %s.\n\nWhen this pull request merges, the release workflow tags the merge commit v%s, builds the archives and publishes the release.\n\n## Changes\n\n' "$version" "$version"
    printf '%s\n' "$notes"
  } >"$body"
  cmd_pr --body-file "$body"
  rm -f "$body"
  say "merge the pull request after review. Then run: scripts/agent done $branch"
}

cmd_done() {
  branch=${1:-$(current_branch)}
  def=$(default_branch)
  [ "$branch" != "$def" ] || die "usage: scripts/agent done [<branch>], from the branch or with its name"
  state=$(cd "$root" && gh pr view "$branch" --json state -q .state 2>/dev/null) ||
    die "no pull request found for $branch"
  [ "$state" = "MERGED" ] || die "the pull request for $branch is $state, not MERGED; nothing was removed"
  wt=$(worktree_of "$branch")
  if [ -d "$wt" ]; then
    say "removing worktree $wt"
    git -C "$root" worktree remove "$wt"
  fi
  if git -C "$root" show-ref --verify --quiet "refs/heads/$branch"; then
    say "deleting local branch $branch"
    git -C "$root" branch --quiet -D "$branch"
  fi
  git -C "$root" worktree prune
  git -C "$root" fetch --quiet --prune origin
  say "done. Update the primary checkout with: git -C $root pull --ff-only"
}

cmd_list() {
  git -C "$root" worktree list --porcelain | sed -n 's/^branch refs\/heads\///p' | while IFS= read -r branch; do
    state=$(cd "$root" && gh pr view "$branch" --json state -q .state 2>/dev/null) || state="no pull request"
    printf '%-40s %s\n' "$branch" "$state"
  done
}

cmd_next() {
  command -v cairn >/dev/null 2>&1 || die "cairn is not installed; see CONTRIBUTING.md"
  cairn -C "$here" next --view agent
}

cmd=${1:-}
[ $# -gt 0 ] && shift
case "$cmd" in
  doctor) cmd_doctor ;;
  start) cmd_start "$@" ;;
  check) cmd_check ;;
  commit) cmd_commit "$@" ;;
  pr) cmd_pr "$@" ;;
  sync) cmd_sync ;;
  land) cmd_land ;;
  take) cmd_take "$@" ;;
  finish) cmd_finish "$@" ;;
  done) cmd_done "$@" ;;
  list) cmd_list ;;
  next) cmd_next ;;
  release) cmd_release "$@" ;;
  *)
    echo "usage: scripts/agent {doctor|next|take|start|check|commit|finish|pr|sync|land|done|list|release}" >&2
    exit 2
    ;;
esac
